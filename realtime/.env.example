NODE_ENV=development

# Port the service listens on. Sockets and the health probes share it.
REALTIME_PORT=4001

# The SAME secret server signs access tokens with. The service only verifies.
# No value here on purpose: a default that works is a default that ships.
JWT_ACCESS_SECRET=

# Redis carries the Socket.IO adapter and the riaya:events channel.
REDIS_URL=redis://localhost:6379

# MongoDB is connected to and never written to in v1.
MONGO_URI=mongodb://localhost:27017/riaya

# Comma-separated allow-list. No wildcard.
REALTIME_CORS_ORIGINS=http://localhost:3000,http://localhost:5174

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
