{
  "name": "realtime",
  "version": "0.1.0",
  "private": true,
  "description": "Authenticated, tenant-scoped realtime fan-out for RI'AYA (Socket.IO + Redis adapter).",
  "scripts": {
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "build": "nest build && node scripts/build-shared.cjs",
    "lint": "eslint \"src/**/*.ts\" --max-warnings=0",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.3",
    "@nestjs/config": "^4.0.2",
    "@nestjs/core": "^11.1.3",
    "@nestjs/jwt": "^11.0.0",
    "@nestjs/mongoose": "^11.0.4",
    "@nestjs/platform-express": "^11.1.3",
    "@nestjs/platform-socket.io": "^11.2.8",
    "@nestjs/websockets": "^11.2.8",
    "@riaya/shared": "workspace:*",
    "@socket.io/redis-adapter": "^8.3.0",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.1",
    "mongoose": "^8.24.8",
    "nestjs-pino": "^5.3.1",
    "pino-http": "^11.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.29.0",
    "@nestjs/cli": "^11.0.7",
    "@types/node": "^22.15.32",
    "eslint": "^9.29.0",
    "eslint-config-prettier": "^10.1.5",
    "globals": "^16.2.0",
    "pino-pretty": "^13.2.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.34.1"
  }
}
