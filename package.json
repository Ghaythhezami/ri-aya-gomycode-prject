{
  "name": "riaya",
  "private": true,
  "version": "0.1.0",
  "description": "RI'AYA (رعاية) — multilingual clinic and appointment management platform",
  "packageManager": "pnpm@10.11.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "concurrently -n web,server,backoffice -c cyan,green,magenta \"pnpm --filter web dev\" \"pnpm --filter server start:dev\" \"pnpm --filter backoffice dev\"",
    "dev:web": "pnpm --filter web dev",
    "dev:server": "pnpm --filter server start:dev",
    "dev:backoffice": "pnpm --filter backoffice dev",
    "build": "pnpm -r --if-present run build",
    "lint": "pnpm -r --if-present run lint",
    "test": "pnpm -r --if-present run test",
    "typecheck": "pnpm -r --if-present run typecheck",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "pnpm --filter server seed",
    "prepare": "husky"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "concurrently": "^9.1.2",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,json,md,css,yml,yaml}": "prettier --write"
  }
}
