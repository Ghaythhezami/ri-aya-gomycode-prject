NODE_ENV=development
PORT=4000
APP_NAME=RI'AYA

# Logging (BP-003). LOG_LEVEL is the only knob: fatal | error | warn | info | debug | trace | silent.
# Unset or unrecognised falls back to info and logs one warning at startup.
# Under NODE_ENV=test logging is silent unless LOG_LEVEL is set explicitly.
LOG_LEVEL=info

# PostgreSQL / Prisma
DATABASE_URL=postgresql://riaya:riaya@localhost:5432/riaya
DB_HOST=localhost
DB_PORT=5432
DB_USER=riaya
DB_PASSWORD=riaya
DB_NAME=riaya
REDIS_URL=redis://localhost:6379
MONGO_URL=mongodb://localhost:27017/riaya
# true for local convenience; use migrations in other environments
DB_SYNC=true
DB_MIGRATIONS_RUN=false

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
COOKIE_SECURE=false
COOKIE_DOMAIN=

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5174

# Public URLs used in emails
BACKOFFICE_URL=http://localhost:5174

# Transactional email (Mailtrap SMTP) — BP-047, NFR-014, NFR-015.
# Names only: real credentials are supplied per environment and are never committed.
# When SMTP_HOST and SMTP_USER are unset the server falls back to the console
# transport, which logs the invitation link instead of sending it (local/test only).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
MAIL_FROM=
