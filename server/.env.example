NODE_ENV=development
PORT=4000
APP_NAME=RI'AYA

# Logging (BP-003). LOG_LEVEL is the only knob: fatal | error | warn | info | debug | trace | silent.
# Unset or unrecognised falls back to info and logs one warning at startup.
# Under NODE_ENV=test logging is silent unless LOG_LEVEL is set explicitly.
LOG_LEVEL=info

# PostgreSQL / Prisma
DATABASE_URL=postgresql://riaya:riaya@localhost:5432/riaya
DB_HOST=localhost
DB_PORT=5432
DB_USER=riaya
DB_PASSWORD=riaya
DB_NAME=riaya
REDIS_URL=redis://localhost:6379
MONGO_URL=mongodb://localhost:27017/riaya
# true for local convenience; use migrations in other environments
DB_SYNC=true
DB_MIGRATIONS_RUN=false

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
COOKIE_SECURE=false
COOKIE_DOMAIN=

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5174

# Public URLs used in emails
BACKOFFICE_URL=http://localhost:5174

# Without REDIS_URL, lockout and revoked tokens use the shared Postgres table security_state.
# SECURITY_STATE_MEMORY=true forces per-process memory instead (not recommended; ADR 0001).
# SECURITY_STATE_MEMORY=true

# Python microservices (ADR 0003). Each is used only when its URL is set; the API signs a
# 60-second HS256 token per call with SERVICE_JWT_SECRET (32+ characters, same value in the services).
# SCHEDULER_URL=http://localhost:4100
# COMMS_URL=http://localhost:4200
# SERVICE_JWT_SECRET=change-me-to-a-random-value-of-at-least-32-characters

# AI assistants and document extraction (ADR 0005). Without ANTHROPIC_API_KEY every AI route answers 503 AI_UNAVAILABLE.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Daily token ceiling per clinic (input + output), counted in Redis/Postgres; exceeded -> 429 AI_BUDGET_EXCEEDED.
# AI_DAILY_TOKEN_BUDGET=2000000

# E-mail (password reset, staff invitations, patient appointment e-mails) via Resend.
# Without RESEND_API_KEY mail is logged to the console. MAIL_FROM must use a domain verified in
# Resend; the default onboarding@resend.dev only delivers to the Resend account owner's address.
# Reserved demo domains (@riaya.local, @example.com, *.example, *.test) are never mailed.
# RESEND_API_KEY=
# MAIL_FROM="RI'AYA <noreply@your-domain.com>"
