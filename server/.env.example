NODE_ENV=development
PORT=4000
APP_NAME=RI'AYA

# PostgreSQL / Prisma
DATABASE_URL=postgresql://riaya:riaya@localhost:5432/riaya
DB_HOST=localhost
DB_PORT=5432
DB_USER=riaya
DB_PASSWORD=riaya
DB_NAME=riaya
REDIS_URL=redis://localhost:6379
MONGO_URL=mongodb://localhost:27017/riaya
# true for local convenience; use migrations in other environments
DB_SYNC=true
DB_MIGRATIONS_RUN=false

# Auth
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_ACCESS_EXPIRES=15m
REFRESH_TOKEN_EXPIRES_DAYS=7
COOKIE_SECURE=false
COOKIE_DOMAIN=

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5174

# Public URLs used in emails
BACKOFFICE_URL=http://localhost:5174
