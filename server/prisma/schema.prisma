generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  CLINIC_ADMIN
  DOCTOR
  RECEPTIONIST
}

enum PreferredLocale {
  en
  ar
  fr
}

/// Lifecycle of a user's link to one clinic.
enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

/// Lifecycle of an invitation (FR-042). `EXPIRED` is NOT stored: it is derived at
/// read time for a PENDING row whose `expiresAt` has passed, so no scheduler is
/// needed and the persisted status stays a single source of truth.
enum InvitationStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
}

/// Recorded outcome of the invitation email send (FR-041). A failed send leaves
/// the invitation PENDING with a resend affordance (AC-049, EC-019).
enum DeliveryStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id              String          @id @default(uuid())
  email           String          @unique
  passwordHash    String
  firstName       String
  lastName        String
  isActive        Boolean         @default(true)
  preferredLocale PreferredLocale @default(en)
  lastLoginAt     DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  /// @deprecated Clinic-scoped role now lives on UserMembership.role.
  /// Retained only while existing call sites are migrated (see tasks T3.3).
  role UserRole?

  /// @deprecated Lockout state moved to Redis (LoginAttemptService, FR-014).
  /// Retained so historical rows keep their values; no longer read by the API.
  failedLoginCount       Int       @default(0)
  failedLoginWindowStart DateTime?
  lockedUntil            DateTime?

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  memberships         UserMembership[]
  sentInvitations     Invitation[]         @relation("InvitationInviter")
  auditLogs           AuditLog[]
  doctorProfiles      Doctor[]

  @@map("users")
}

/// Ownership boundary. An organization groups one or more clinics.
model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinics     Clinic[]
  memberships UserMembership[]
  invitations Invitation[]
  auditLogs   AuditLog[]
  roles       Role[]

  @@map("organizations")
}

/// The working workspace. All clinical data is scoped to a clinic.
model Clinic {
  id              String          @id @default(uuid())
  organizationId  String
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  timezone        String          @default("UTC")
  currency        String          @default("USD")
  address         String?
  /// Clinic settings (BP-035): contact details shown on the settings screen.
  contactEmail    String?
  phone           String?
  defaultLanguage PreferredLocale @default(en)
  /// Weekly operating hours as a JSON object keyed by weekday (BP-035).
  workingHours    Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  memberships  UserMembership[]
  invitations  Invitation[]
  auditLogs    AuditLog[]
  roles        Role[]
  patients     Patient[]
  doctors      Doctor[]
  appointments Appointment[]

  @@index([organizationId])
  @@map("clinics")
}

/// Links one global identity to one clinic with one role. This is what makes a
/// user able to hold a different role per clinic (FR-001, FR-028).
model UserMembership {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinicId       String
  clinic         Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  role           UserRole
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, clinicId])
  @@index([userId, status])
  @@index([clinicId, status])
  @@map("user_memberships")
}

/// Single-use, expiring invitation to join one clinic with one role (FR-007).
model Invitation {
  id             String           @id @default(uuid())
  email          String
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinicId       String
  clinic         Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  role           UserRole
  tokenHash      String           @unique
  expiresAt      DateTime
  consumedAt     DateTime?
  /// Persisted lifecycle status (FR-042). `EXPIRED` is derived, never stored.
  status         InvitationStatus @default(PENDING)
  /// Recorded outcome of the invitation email send (FR-041, AC-048).
  deliveryStatus DeliveryStatus   @default(PENDING)
  /// Provider error captured when a send fails, so a resend can be offered (EC-019).
  deliveryError  String?
  invitedById    String?
  invitedBy      User?            @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([email, clinicId])
  @@index([expiresAt])
  @@index([clinicId, status])
  @@map("invitations")
}

/// A clinic-scoped custom role (BP-035). The four built-in roles stay in the
/// UserRole enum; this table holds additional role definitions and the
/// capabilities they grant.
model Role {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinicId       String
  clinic         Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name           String
  /// Base built-in role whose capability ceiling this custom role cannot exceed.
  baseRole       UserRole
  /// JSON array of capability keys from @riaya/shared.
  permissions    Json
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([clinicId, name])
  @@index([organizationId])
  @@map("roles")
}

/// Append-only record of every mutation (FR-016, NFR-013).
model AuditLog {
  id             String        @id @default(uuid())
  actorUserId    String?
  actor          User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action         String
  entity         String
  entityId       String
  before         Json?
  after          Json?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  clinicId       String?
  clinic         Clinic?       @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())

  @@index([entity, entityId])
  @@index([actorUserId])
  @@index([clinicId, createdAt])
  @@map("audit_logs")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The workspace the token was issued for (BP-010). Nullable for legacy rows;
  // a null row falls back to the default scope once, then carries the scope.
  clinicId  String?
  familyId  String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Lifecycle of one appointment. Transitions are BP-019's; this feature only
/// defines the states a row can hold (BP-002, FR-003).
enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

/// A person receiving care at one clinic. Deliberately carries no credentials:
/// patients do not authenticate in this version (BP-002, FR-001).
model Patient {
  id          String   @id @default(uuid())
  clinicId    String
  clinic      Clinic   @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  firstName   String
  lastName    String
  dateOfBirth DateTime
  phone       String
  email       String?
  gender      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  appointments Appointment[]

  /// The patient directory lists and searches by clinic, then name (BP-015).
  @@index([clinicId, lastName])
  @@map("patients")
}

/// A clinician's profile at one clinic. It MAY link to a global identity through
/// `userId`; deleting that identity keeps the clinical record (BP-002, FR-002, EC-004).
model Doctor {
  id                  String   @id @default(uuid())
  clinicId            String
  clinic              Clinic   @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  userId              String?
  user                User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  specialty           String
  licenseNumber       String?
  consultationMinutes Int      @default(30)
  isActive            Boolean  @default(true)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  appointments Appointment[]

  @@index([clinicId, isActive])
  @@map("doctors")
}

/// One booked visit. Every row is clinic-scoped, and the two indexes below are the
/// access paths BP-015 and BP-019 depend on (BP-002, FR-003, FR-005).
model Appointment {
  id        String            @id @default(uuid())
  clinicId  String
  clinic    Clinic            @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  patientId String
  patient   Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId  String
  doctor    Doctor            @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  startsAt  DateTime
  endsAt    DateTime
  status    AppointmentStatus @default(SCHEDULED)
  reason    String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  /// A doctor's day: ordered by start time inside one doctor (FR-005).
  @@index([doctorId, startsAt])
  /// A patient's history: every appointment for one patient (FR-005).
  @@index([patientId])
  @@map("appointments")
}
