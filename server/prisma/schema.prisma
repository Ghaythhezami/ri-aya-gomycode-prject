generator client {
  provider      = "prisma-client-js"
  // native for local development, rhel-openssl-3.0.x for Vercel functions.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  SUPER_ADMIN
  CLINIC_ADMIN
  DOCTOR
  RECEPTIONIST
}

enum PreferredLocale {
  en
  ar
  fr
}

/// Lifecycle of a user's link to one clinic.
enum MembershipStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id                    String          @id @default(uuid())
  email                 String          @unique
  passwordHash          String
  firstName             String
  lastName              String
  /// Optional per-language spellings {en, ar, fr}; firstName/lastName stay the canonical value.
  firstNameI18n         Json            @default("{}")
  lastNameI18n          Json            @default("{}")
  phone                 String?
  jobTitle              String?
  /// Set when the user finishes (or skips) the onboarding wizard.
  onboardingCompletedAt DateTime?
  isActive              Boolean         @default(true)
  preferredLocale       PreferredLocale @default(en)
  lastLoginAt           DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  /// @deprecated Clinic-scoped role now lives on UserMembership.role.
  /// Retained only while existing call sites are migrated (see tasks T3.3).
  role UserRole?

  /// @deprecated Lockout state moved to Redis (LoginAttemptService, FR-014).
  /// Retained so historical rows keep their values; no longer read by the API.
  failedLoginCount       Int       @default(0)
  failedLoginWindowStart DateTime?
  lockedUntil            DateTime?

  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  memberships         UserMembership[]
  sentInvitations     Invitation[]         @relation("InvitationInviter")
  auditLogs           AuditLog[]
  doctorProfiles      Doctor[]

  @@map("users")
}

/// Ownership boundary. An organization groups one or more clinics.
model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clinics     Clinic[]
  memberships UserMembership[]
  invitations Invitation[]
  auditLogs   AuditLog[]

  @@map("organizations")
}

/// The working workspace. All clinical data is scoped to a clinic.
model Clinic {
  id             String       @id @default(uuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  nameI18n       Json         @default("{}")
  timezone       String       @default("UTC")
  currency       String       @default("USD")
  address        String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  memberships           UserMembership[]
  invitations           Invitation[]
  auditLogs             AuditLog[]
  patients              Patient[]
  doctors               Doctor[]
  appointments          Appointment[]
  rooms                 Room[]
  queueEntries          QueueEntry[]
  notifications         Notification[]
  settings              ClinicSettings?
  optimizationRuns      OptimizationRun[]
  conversations         ChatConversation[]
  roles                 ClinicRole[]
  appointmentTypes      AppointmentTypeDef[]
  /// Set when an administrator finishes the clinic onboarding checklist.
  onboardingCompletedAt DateTime?

  @@index([organizationId])
  @@map("clinics")
}

/// Links one global identity to one clinic with one role. This is what makes a
/// user able to hold a different role per clinic (FR-001, FR-028).
model UserMembership {
  id             String           @id @default(uuid())
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinicId       String
  clinic         Clinic           @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  role           UserRole
  /// Custom or customised role of the clinic; null = the system role named by `role`.
  roleId         String?
  clinicRole     ClinicRole?      @relation(fields: [roleId], references: [id], onDelete: Restrict)
  status         MembershipStatus @default(ACTIVE)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@unique([userId, clinicId])
  @@index([roleId])
  @@index([userId, status])
  @@index([clinicId, status])
  @@map("user_memberships")
}

/// Single-use, expiring invitation to join one clinic with one role (FR-007).
model Invitation {
  id             String       @id @default(uuid())
  email          String
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  clinicId       String
  clinic         Clinic       @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  role           UserRole
  roleId         String?
  clinicRole     ClinicRole?  @relation(fields: [roleId], references: [id], onDelete: SetNull)
  tokenHash      String       @unique
  expiresAt      DateTime
  consumedAt     DateTime?
  invitedById    String?
  invitedBy      User?        @relation("InvitationInviter", fields: [invitedById], references: [id], onDelete: SetNull)
  createdAt      DateTime     @default(now())

  @@index([email, clinicId])
  @@index([expiresAt])
  @@map("invitations")
}

/// Append-only record of every mutation (FR-016, NFR-013).
model AuditLog {
  id             String        @id @default(uuid())
  actorUserId    String?
  actor          User?         @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action         String
  entity         String
  entityId       String
  before         Json?
  after          Json?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  clinicId       String?
  clinic         Clinic?       @relation(fields: [clinicId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())

  @@index([entity, entityId])
  @@index([actorUserId])
  @@index([clinicId, createdAt])
  @@index([clinicId, entity, createdAt])
  @@map("audit_logs")
}

model RefreshToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  // The workspace the token was issued for (BP-010). Nullable for legacy rows;
  // a null row falls back to the default scope once, then carries the scope.
  clinicId  String?
  familyId  String
  tokenHash String    @unique
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([familyId])
  @@map("refresh_tokens")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId])
  @@map("password_reset_tokens")
}

/// Lifecycle of one appointment. Allowed transitions live in
/// appointments/appointment-state.ts (APP-1).
enum AppointmentStatus {
  SCHEDULED
  CONFIRMED
  CHECKED_IN
  IN_PROGRESS
  COMPLETED
  CANCELLED
  NO_SHOW
}

enum PatientStatus {
  ACTIVE
  ARCHIVED
}

enum QueuePriority {
  NORMAL
  URGENT
  EMERGENCY
}

enum QueueStatus {
  WAITING
  CALLED
  IN_CONSULTATION
  COMPLETED
  NO_SHOW
  RESCHEDULED
}

enum DeliveryStatus {
  PENDING
  SENT
  FAILED
  CANCELLED
}

enum OptimizationStatus {
  PROPOSED
  APPLIED
  UNDONE
  REJECTED
}

/// A person receiving care at one clinic. Patients do not authenticate.
model Patient {
  id                String        @id @default(uuid())
  clinicId          String
  clinic            Clinic        @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  /// Human-readable id, unique per clinic (P-001).
  code              String
  firstName         String
  lastName          String
  firstNameI18n     Json          @default("{}")
  lastNameI18n      Json          @default("{}")
  /// Lower-cased canonical and per-language names, code and phone, for search (trigram index).
  searchText        String        @default("")
  dateOfBirth       DateTime
  phone             String
  email             String?
  gender            String?
  address           String?
  status            PatientStatus @default(ACTIVE)
  archivedAt        DateTime?
  /// Clinical notes: doctors and admins only (PAT-2 field-level permission).
  clinicalNotes     String?
  /// Administrative notes: visible to every staff role.
  adminNotes        String?
  contactPreference String        @default("SMS")
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  appointments          Appointment[]
  queueEntries          QueueEntry[]
  /// STAFF (created at the desk) or PORTAL (self-registered from the patient portal).
  source                String            @default("STAFF")
  /// Set on portal self-registrations that match an existing record (phone + birth date);
  /// staff review and merge — never linked automatically.
  possibleDuplicateOfId String?
  portalAccount         PatientAccount?
  documents             PatientDocument[]
  summaries             PatientSummary[]

  @@unique([clinicId, code])
  @@index([clinicId, lastName])
  @@index([clinicId, phone])
  @@index([clinicId, status])
  @@index([searchText(ops: raw("gin_trgm_ops"))], type: Gin, map: "patients_searchText_trgm_idx")
  @@map("patients")
}

/// A physical room or piece of equipment that can be booked once at a time.
model Room {
  id        String   @id @default(uuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  name      String
  nameI18n  Json     @default("{}")
  kind      String   @default("CONSULTATION")
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  doctors      Doctor[]
  appointments Appointment[]
  queueEntries QueueEntry[]

  @@unique([clinicId, name])
  @@map("rooms")
}

/// A clinician's profile at one clinic. It MAY link to a global identity through `userId`.
model Doctor {
  id                  String   @id @default(uuid())
  clinicId            String
  clinic              Clinic   @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  userId              String?
  user                User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  firstName           String   @default("")
  lastName            String   @default("")
  firstNameI18n       Json     @default("{}")
  lastNameI18n        Json     @default("{}")
  specialty           String
  licenseNumber       String?
  consultationMinutes Int      @default(30)
  isActive            Boolean  @default(true)
  roomId              String?
  room                Room?    @relation(fields: [roomId], references: [id], onDelete: SetNull)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  appointments Appointment[]
  workingHours WorkingHour[]
  leaves       DoctorLeave[]

  @@index([clinicId, isActive])
  @@map("doctors")
}

/// One interval on a weekday (0 = Sunday). Several rows per day are allowed;
/// `kind = BREAK` rows carve breaks out of the working intervals (DOC-2).
model WorkingHour {
  id          String @id @default(uuid())
  doctorId    String
  doctor      Doctor @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  weekday     Int
  /// Minutes after local midnight in the clinic time zone.
  startMinute Int
  endMinute   Int
  kind        String @default("WORK")

  @@index([doctorId, weekday])
  @@map("working_hours")
}

/// A leave or holiday that blocks a doctor's availability between two instants.
model DoctorLeave {
  id        String   @id @default(uuid())
  doctorId  String
  doctor    Doctor   @relation(fields: [doctorId], references: [id], onDelete: Cascade)
  startsAt  DateTime
  endsAt    DateTime
  reason    String?
  createdAt DateTime @default(now())

  @@index([doctorId, startsAt])
  @@map("doctor_leaves")
}

/// One booked visit. Overlaps per doctor are rejected by the `appointments_no_overlap`
/// exclusion constraint added in SQL (APP-2).
model Appointment {
  id               String            @id @default(uuid())
  clinicId         String
  clinic           Clinic            @relation(fields: [clinicId], references: [id], onDelete: Restrict)
  /// Human-readable id, unique per clinic (AP-1001).
  code             String
  patientId        String
  patient          Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  doctorId         String
  doctor           Doctor            @relation(fields: [doctorId], references: [id], onDelete: Restrict)
  roomId           String?
  room             Room?             @relation(fields: [roomId], references: [id], onDelete: SetNull)
  startsAt         DateTime
  endsAt           DateTime
  status           AppointmentStatus @default(SCHEDULED)
  /// Code of an AppointmentTypeDef of the clinic (system codes: CONSULTATION, FOLLOW_UP, EMERGENCY).
  type             String            @default("CONSULTATION")
  reason           String?
  notes            String?
  cancelReason     String?
  /// Locked appointments are never moved by the optimiser.
  locked           Boolean           @default(false)
  /// Set when the doctor is deactivated: staff must reschedule (DOC-1).
  needsReschedule  Boolean           @default(false)
  reminderChannels String[]          @default(["SMS", "EMAIL"])
  /// STAFF, PORTAL (booked by the patient) or ASSISTANT (confirmed from an AI proposal).
  source           String            @default("STAFF")
  createdById      String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  queueEntry QueueEntry?
  reminders  ReminderDelivery[]

  @@unique([clinicId, code])
  @@index([doctorId, startsAt])
  @@index([patientId])
  @@index([clinicId, startsAt])
  @@index([clinicId, status])
  @@index([clinicId, patientId, startsAt])
  @@index([clinicId, status, startsAt])
  @@map("appointments")
}

/// Live queue entry created at check-in (QUE-1).
model QueueEntry {
  id            String        @id @default(uuid())
  clinicId      String
  clinic        Clinic        @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  appointmentId String        @unique
  appointment   Appointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  patientId     String
  patient       Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  roomId        String?
  room          Room?         @relation(fields: [roomId], references: [id], onDelete: SetNull)
  /// Display number, unique per clinic and day (A010).
  number        String
  priority      QueuePriority @default(NORMAL)
  status        QueueStatus   @default(WAITING)
  /// DESK or QR (self check-in).
  source        String        @default("DESK")
  checkedInAt   DateTime      @default(now())
  calledAt      DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  delayMinutes  Int           @default(0)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([clinicId, status])
  @@index([clinicId, checkedInAt])
  @@index([clinicId, status, checkedInAt])
  @@map("queue_entries")
}

/// Clinic configuration (SET-1). One row per clinic.
model ClinicSettings {
  id                      String   @id @default(uuid())
  clinicId                String   @unique
  clinic                  Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  contactEmail            String?
  phone                   String?
  defaultLanguage         String   @default("en")
  /// Cancellations closer than this to the start are "late" and need an admin.
  cancellationNoticeHours Int      @default(2)
  requireCancelReason     Boolean  @default(true)
  targetWaitMinutes       Int      @default(15)
  slotMinutes             Int      @default(15)
  /// { CONSULTATION: 30, FOLLOW_UP: 15, EMERGENCY: 20 }
  durations               Json
  /// Minutes before start, e.g. [1440, 120].
  reminderOffsets         Int[]    @default([1440, 120])
  reminderChannels        String[] @default(["SMS", "EMAIL"])
  /// [{ weekday, open, close, closed }] in minutes after local midnight.
  openingHours            Json
  /// [{ id, name, specialties: string[] }]
  departments             Json
  /// { density, highContrast, reduceMotion }
  appearance              Json
  /// Patient portal: patients can sign in, book and manage their own appointments.
  patientPortalEnabled    Boolean  @default(true)
  /// Patients may create an account from the landing page (otherwise invite-only).
  patientSelfRegistration Boolean  @default(true)
  /// AI assistants (Claude API) for this clinic's staff and patients.
  aiAssistantsEnabled     Boolean  @default(true)
  updatedAt               DateTime @updatedAt

  @@map("clinic_settings")
}

/// In-app notification (RT-3). Stored in PostgreSQL per the Ri'aya feature doc.
model Notification {
  id         String   @id @default(uuid())
  clinicId   String
  clinic     Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  /// null = every staff member of the clinic.
  userId     String?
  category   String
  titleKey   String
  bodyKey    String
  params     Json
  entityType String?
  entityId   String?
  /// Makes creation idempotent on retries.
  dedupeKey  String   @unique
  readBy     String[] @default([])
  createdAt  DateTime @default(now())

  @@index([clinicId, createdAt])
  @@map("notifications")
}

/// One reminder for one appointment on one channel (APP-5).
model ReminderDelivery {
  id            String         @id @default(uuid())
  appointmentId String
  appointment   Appointment    @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  channel       String
  offsetMinutes Int
  scheduledFor  DateTime
  status        DeliveryStatus @default(PENDING)
  attempts      Int            @default(0)
  sentAt        DateTime?
  error         String?
  createdAt     DateTime       @default(now())

  @@unique([appointmentId, channel, offsetMinutes])
  @@index([status, scheduledFor])
  @@map("reminder_deliveries")
}

/// A smart-scheduling proposal and its lifecycle (SMT-2, SMT-3).
model OptimizationRun {
  id              String             @id @default(uuid())
  clinicId        String
  clinic          Clinic             @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  /// Local clinic date, YYYY-MM-DD.
  date            String
  objective       String
  /// Hash of the day's schedule when the proposal was generated (stale check).
  scheduleVersion String
  proposal        Json
  status          OptimizationStatus @default(PROPOSED)
  createdById     String?
  appliedAt       DateTime?
  undoneAt        DateTime?
  createdAt       DateTime           @default(now())

  @@index([clinicId, date])
  @@map("optimization_runs")
}

/// Staff chat (RT-2), stored in PostgreSQL per the Ri'aya feature doc.
model ChatConversation {
  id        String   @id @default(uuid())
  clinicId  String
  clinic    Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  title     String?
  isGroup   Boolean  @default(false)
  memberIds String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  messages ChatMessage[]

  @@index([clinicId])
  @@index([clinicId, updatedAt])
  @@index([memberIds], type: Gin)
  @@map("chat_conversations")
}

model ChatMessage {
  id             String           @id @default(uuid())
  conversationId String
  conversation   ChatConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  body           String
  readBy         String[]         @default([])
  createdAt      DateTime         @default(now())

  @@index([conversationId, createdAt])
  @@map("chat_messages")
}

/// Shared security state (lockout counters, revoked refresh tokens) when Redis is
/// not configured. Same semantics as the Redis keys: JSON value + expiry (ADR 0001).
model SecurityState {
  key       String   @id
  value     String
  expiresAt DateTime

  @@index([expiresAt])
  @@map("security_state")
}

/// A clinic role: a customised system role (key = UserRole name, isSystem) or a custom role.
/// Effective capabilities of a membership = its role row, else the default matrix of `role`.
model ClinicRole {
  id           String   @id @default(uuid())
  clinicId     String
  clinic       Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  /// Slug, unique per clinic. System roles use the UserRole name.
  key          String
  /// LocalizedText {en, ar, fr}.
  name         Json
  description  Json     @default("{}")
  /// Data-scope behaviour (a DOCTOR-based role sees its own schedule) and the legacy role.
  baseRole     UserRole
  capabilities String[]
  isSystem     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  memberships UserMembership[]
  invitations Invitation[]

  @@unique([clinicId, key])
  @@map("clinic_roles")
}

/// Appointment types of a clinic. The three system types exist for every clinic.
model AppointmentTypeDef {
  id              String   @id @default(uuid())
  clinicId        String
  clinic          Clinic   @relation(fields: [clinicId], references: [id], onDelete: Cascade)
  /// Upper-case code stored on appointments.type, unique per clinic.
  code            String
  /// LocalizedText {en, ar, fr}.
  name            Json
  durationMinutes Int
  /// Design-token colour key (primary, info, success, warning, alert, violet).
  color           String   @default("primary")
  /// Emergency types are never moved by the optimiser and jump the queue.
  isEmergency     Boolean  @default(false)
  isActive        Boolean  @default(true)
  isSystem        Boolean  @default(false)
  sortOrder       Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([clinicId, code])
  @@index([clinicId, isActive])
  @@map("appointment_types")
}

/// Patient portal identity, separate from staff users (own JWT audience `riaya-portal`).
model PatientAccount {
  id                    String    @id @default(uuid())
  clinicId              String
  patientId             String    @unique
  patient               Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  /// Lower-cased; unique per clinic (the same person may use several clinics).
  email                 String
  passwordHash          String
  preferredLocale       String    @default("en")
  emailVerifiedAt       DateTime?
  /// Consent to process the patient's data with the AI assistant (Claude API).
  aiConsentAt           DateTime?
  privacyAcceptedAt     DateTime
  onboardingCompletedAt DateTime?
  lastLoginAt           DateTime?
  failedLoginCount      Int       @default(0)
  lockedUntil           DateTime?
  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  refreshTokens PatientRefreshToken[]

  @@unique([clinicId, email])
  @@index([clinicId])
  @@map("patient_accounts")
}

model PatientRefreshToken {
  id        String         @id @default(uuid())
  accountId String
  account   PatientAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  tokenHash String         @unique
  familyId  String
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime       @default(now())

  @@index([accountId])
  @@index([familyId])
  @@map("patient_refresh_tokens")
}

/// One-time link (shown as QR code at the desk) that attaches a portal account to an
/// existing patient record.
model PatientInvite {
  id          String    @id @default(uuid())
  clinicId    String
  patientId   String
  tokenHash   String    @unique
  expiresAt   DateTime
  consumedAt  DateTime?
  createdById String?
  createdAt   DateTime  @default(now())

  @@index([patientId])
  @@map("patient_invites")
}

/// Uploaded clinical document (PDF or image) with AI text extraction and summary.
model PatientDocument {
  id            String    @id @default(uuid())
  clinicId      String
  patientId     String
  patient       Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  /// STAFF or PATIENT (uploaded from the portal, pending review).
  uploadedBy    String    @default("STAFF")
  uploaderId    String?
  fileName      String
  mimeType      String
  sizeBytes     Int
  /// SHA-256 of the bytes: duplicate detection and re-processing skips.
  sha256        String
  content       Bytes
  /// PENDING, PROCESSING, READY, FAILED
  status        String    @default("PENDING")
  /// lab_result, prescription, imaging_report, referral, discharge_summary, other
  category      String?
  documentDate  DateTime?
  extractedText String?
  /// Structured extraction (title, findings, values, medications) as JSON.
  extraction    Json?
  summary       String?
  errorCode     String?
  reviewedAt    DateTime?
  reviewedById  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@unique([patientId, sha256])
  @@index([clinicId, patientId, createdAt])
  @@map("patient_documents")
}

/// Doctor-reviewed patient summary (AI draft edited by a clinician); optionally shared
/// with the patient in the portal.
model PatientSummary {
  id               String    @id @default(uuid())
  clinicId         String
  patientId        String
  patient          Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  authorId         String
  /// Markdown, clinician-approved.
  content          String
  /// Plain-language version for the patient (shared only when visibleToPatient).
  patientContent   String?
  sources          Json      @default("[]")
  visibleToPatient Boolean   @default(false)
  publishedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([clinicId, patientId, createdAt])
  @@map("patient_summaries")
}

/// Assistant conversation (staff, doctor or patient persona); messages kept as the Claude
/// API content blocks so the history replays exactly.
model AiConversation {
  id           String   @id @default(uuid())
  clinicId     String
  /// STAFF_USER or PATIENT_ACCOUNT
  actorType    String
  actorId      String
  /// staff, doctor or patient
  persona      String
  title        String?
  messages     Json     @default("[]")
  inputTokens  Int      @default(0)
  outputTokens Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([clinicId, actorType, actorId, updatedAt])
  @@map("ai_conversations")
}
