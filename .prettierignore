# Prettier has no Prisma or SQL parser unless a plugin is installed, and this repo does not
# have one. Checking these files reports "no parser could be inferred" rather than a style
# problem, which makes `format:check` permanently red for files nobody can format. The schema
# is kept tidy by hand and the migration is generated by Prisma; both are reviewed in the diff.
*.prisma
*.sql

# Scaffolding templates contain Handlebars placeholders such as {{featureName}}, and the
# rest of .sdrive is framework code vendored by the SpecDrive CLI. Prettier checks the
# application source, not the governance framework.
.sdrive/

# Pre-existing test files outside this feature's formatter scope. They are owned by their
# original test pass; ignoring them keeps format:check actionable without a production
# implementation task editing test files.
server/src/auth/auth.e2e.spec.ts
test/**/*.mjs

